# Copy to .env for local Docker Compose. Never commit real secrets.
NODE_ENV=development

POSTGRES_PASSWORD=postgres
ERP_APP_PASSWORD=erp_app

# API
PORT=4000
DATABASE_URL=postgresql://erp_app:erp_app@localhost:5432/schoolerp
DATABASE_OWNER_URL=postgresql://postgres:postgres@localhost:5432/schoolerp
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-32chars
JWT_REFRESH_PEPPER=dev-only-refresh-pepper-change-me
PLATFORM_TOKEN_TTL_SECONDS=28800
BASE_DOMAIN=localhost
APP_ORIGIN=http://localhost:5173
ALLOW_TENANT_HEADER=true
TRUST_PROXY=false

# S3 / MinIO (used by the storage module when enabled)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=schoolerp
S3_ACCESS_KEY=schoolerp
S3_SECRET_KEY=schoolerp-dev-secret

# MinIO root credentials for Compose
MINIO_ROOT_USER=schoolerp
MINIO_ROOT_PASSWORD=schoolerp-dev-secret

# Optional delivery / scale integrations. Leave empty for console/db defaults.
# NOTIFICATION_WEBHOOK_URL=
# PUSH_WEBHOOK_URL=
# READ_REPLICA_URL=
# QUEUE_DRIVER=db
# QUEUE_WEBHOOK_URL=

# Notification vendors (console defaults; fail fast when a vendor is selected
# without credentials). SendGrid handles email, Twilio handles SMS/WhatsApp.
# EMAIL_PROVIDER=console          # console | sendgrid
# SENDGRID_API_KEY=
# NOTIFICATION_FROM_EMAIL=no-reply@example.com
# NOTIFICATION_FROM_NAME=SchoolERP
# SMS_PROVIDER=console            # console | twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+10000000000

# Payment checkout adapters (mock by default). Stripe for cards, Khalti and
# eSewa for Nepal wallets/banks. Secrets stay in the deployment environment.
# PAYMENT_GATEWAY_PROVIDER=mock   # default when a request omits provider: mock | esewa | khalti | stripe | bank
# PAYMENT_GATEWAY_WEBHOOK_SECRET=
# PAYMENT_GATEWAY_CHECKOUT_BASE_URL=
# Optional settlement feed for POST /payments/reconciliations/pull. Expected
# payload: an array of lines, or {"lines":[...]}, with providerRef, amountMinor,
# feeMinor?, currency?, status?, settledAt and optional notes.
# PAYMENT_SETTLEMENT_FEED_URL=
# PAYMENT_SETTLEMENT_FEED_TOKEN=
# STRIPE_SECRET_KEY=
# KHALTI_SECRET_KEY=
# KHALTI_CHECKOUT_URL=
# ESEWA_SECRET_KEY=
# ESEWA_PRODUCT_CODE=
# ESEWA_CHECKOUT_URL=

# Tenant lifecycle: grace period before a requested deletion becomes purge-
# eligible, and the age cutoff for notification retention cleanup.
TENANT_DELETION_GRACE_DAYS=30
RETENTION_NOTIFICATION_DAYS=365

# Desktop offline database key (32+ chars). Omit to auto-generate one.
# SCHOOLERP_DB_KEY=
