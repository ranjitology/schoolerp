# Copy to .env for local Docker Compose. Never commit real secrets.
NODE_ENV=development

POSTGRES_PASSWORD=postgres
ERP_APP_PASSWORD=erp_app

# API
PORT=4000
DATABASE_URL=postgresql://erp_app:erp_app@localhost:5432/schoolerp
DATABASE_OWNER_URL=postgresql://postgres:postgres@localhost:5432/schoolerp
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-32chars
JWT_REFRESH_PEPPER=dev-only-refresh-pepper-change-me
PLATFORM_TOKEN_TTL_SECONDS=28800
BASE_DOMAIN=localhost
APP_ORIGIN=http://localhost:5173
ALLOW_TENANT_HEADER=true
TRUST_PROXY=false

# S3 / MinIO (used by the storage module when enabled)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=schoolerp
S3_ACCESS_KEY=schoolerp
S3_SECRET_KEY=schoolerp-dev-secret

# MinIO root credentials for Compose
MINIO_ROOT_USER=schoolerp
MINIO_ROOT_PASSWORD=schoolerp-dev-secret

# Optional delivery / scale integrations. Leave empty for console/db defaults.
# NOTIFICATION_WEBHOOK_URL=
# PAYMENT_GATEWAY_PROVIDER=mock
# PAYMENT_GATEWAY_WEBHOOK_SECRET=
# PAYMENT_GATEWAY_CHECKOUT_BASE_URL=
# PUSH_WEBHOOK_URL=
# READ_REPLICA_URL=
# QUEUE_DRIVER=db
# QUEUE_WEBHOOK_URL=

# Desktop offline database key (32+ chars). Omit to auto-generate one.
# SCHOOLERP_DB_KEY=
