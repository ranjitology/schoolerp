// Multi-tenant School ERP — shared database, shared schema.
// Every tenant-owned table carries school_id (UUID) and is protected by
// PostgreSQL RLS (see prisma/rls.sql). Control-plane tables are platform-only.
//
// Money: integer minor units (paisa/cents). Dates: calendar dates are @db.Date.
// IDs: UUIDv7 generated by the application; gen_random_uuid() is a safe default.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Control plane ─────────────────────────

enum SchoolStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum PlatformInvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
}

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT
  BILLING
}

enum CalendarSystem {
  AD
  BS
}

model School {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String         @unique @db.VarChar(32)
  name            String         @db.VarChar(160)
  status          SchoolStatus   @default(TRIAL)
  planId          String?        @db.Uuid
  timezone        String         @default("Asia/Kathmandu") @db.VarChar(64)
  locale          String         @default("en-NP") @db.VarChar(16)
  currency        String         @default("NPR") @db.Char(3)
  calendarSystem  CalendarSystem @default(AD)
  dataRegion      String         @default("ap-south-1") @db.VarChar(32)
  dataPlane       String         @default("SHARED") @db.VarChar(16)
  dedicatedDbRef  String?        @db.VarChar(120)
  limitsOverride  Json           @default("{}") @db.JsonB
  modulesOverride Json           @default("{}") @db.JsonB
  branding        Json           @default("{}") @db.JsonB
  trialEndsAt     DateTime?      @db.Timestamptz(6)
  suspendedAt     DateTime?      @db.Timestamptz(6)
  deletedAt       DateTime?      @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(6)

  plan               Plan?                 @relation(fields: [planId], references: [id], onDelete: SetNull)
  settings           SchoolSetting?
  subscription       Subscription?
  platformInvoices   PlatformInvoice[]
  roles              Role[]
  users              User[]
  refreshTokens      RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  loginHistory       LoginHistory[]
  devices            Device[]
  auditLogs          AuditLog[]
  usageCounters      UsageCounter[]
  academicYears      AcademicYear[]
  terms              Term[]
  holidays           Holiday[]
  classes            Class[]
  sections           Section[]
  subjects           Subject[]
  classSubjects      ClassSubject[]
  teachingAssignments TeachingAssignment[]
  staff              Staff[]
  staffDocuments     StaffDocument[]
  staffLeaves        StaffLeave[]
  staffAttendance    StaffAttendance[]
  payrollRuns        PayrollRun[]
  payslips           Payslip[]
  students           Student[]
  guardians          Guardian[]
  studentDocuments   StudentDocument[]
  admissionApplications AdmissionApplication[]
  attendanceSessions AttendanceSession[]
  attendanceRecords  AttendanceRecord[]
  timetablePeriods   TimetablePeriod[]
  timetableSlots     TimetableSlot[]
  timetableSubstitutions TimetableSubstitution[]
  gradingScales      GradingScale[]
  gradeBands         GradeBand[]
  exams              Exam[]
  examSubjects       ExamSubject[]
  marks              Mark[]
  examResults        ExamResult[]
  feeHeads           FeeHead[]
  feeStructures      FeeStructure[]
  studentDiscounts   StudentDiscount[]
  invoices           Invoice[]
  invoiceLines       InvoiceLine[]
  payments           Payment[]
  paymentAllocations PaymentAllocation[]
  refunds            Refund[]
  expenses           Expense[]
  numberSequences    NumberSequence[]
  receiptBlocks      ReceiptBlock[]
  idempotencyRecords IdempotencyRecord[]
  notices            Notice[]
  noticeAttachments  NoticeAttachment[]
  notifications      Notification[]
  notificationDeliveries NotificationDelivery[]
  savedViews         SavedView[]
  importJobs         ImportJob[]
  storageObjects     StorageObject[]
  outboxConflicts    OutboxConflict[]
  impersonationSessions ImpersonationSession[]
  homework           Homework[]
  ledgerAccounts     LedgerAccount[]
  journalEntries     JournalEntry[]
  journalLines       JournalLine[]
  paymentIntents     PaymentIntent[]
  paymentWebhookEvents PaymentWebhookEvent[]
  pushSubscriptions  PushSubscription[]
  documentTemplates  DocumentTemplate[]
  generatedDocuments GeneratedDocument[]
  reportDailyAttendance ReportDailyAttendance[]
  reportFeeCollection ReportFeeCollection[]

  @@index([status, createdAt])
  @@map("schools")
}

model Plan {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String          @unique @db.VarChar(32)
  name        String          @db.VarChar(80)
  description String?         @db.VarChar(500)
  priceMinor  Int             @default(0)
  currency    String          @default("NPR") @db.Char(3)
  interval    BillingInterval @default(YEARLY)
  limits      Json            @db.JsonB
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(6)

  schools       School[]
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId           String             @unique @db.Uuid
  planId             String             @db.Uuid
  status             SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime?          @db.Timestamptz(6)
  currentPeriodStart DateTime           @db.Timestamptz(6)
  currentPeriodEnd   DateTime           @db.Timestamptz(6)
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

model PlatformInvoice {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String                @db.Uuid @map("school_id")
  number      String                @unique @db.VarChar(40)
  amountMinor Int
  currency    String                @default("NPR") @db.Char(3)
  status      PlatformInvoiceStatus @default(OPEN)
  dueAt       DateTime              @db.Timestamptz(6)
  paidAt      DateTime?             @db.Timestamptz(6)
  lineItems   Json                  @db.JsonB
  createdAt   DateTime              @default(now()) @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@map("platform_invoices")
}

model PlatformUser {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String       @unique @db.VarChar(254)
  passwordHash      String       @db.VarChar(255)
  fullName          String       @db.VarChar(120)
  role              PlatformRole @default(SUPPORT)
  status            String       @default("ACTIVE") @db.VarChar(20)
  totpSecret        String?      @db.VarChar(64)
  totpEnabled       Boolean      @default(false)
  totpLastStep      Int?
  failedAttempts    Int          @default(0)
  lockedUntil       DateTime?    @db.Timestamptz(6)
  lastLoginAt       DateTime?    @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(6)

  auditLogs       PlatformAuditLog[]
  impersonations  ImpersonationSession[]

  @@map("platform_users")
}

model PlatformAuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platformUserId String?  @db.Uuid
  action         String   @db.VarChar(80)
  entity         String   @db.VarChar(80)
  entityId       String?  @db.VarChar(80)
  schoolId       String?  @db.Uuid @map("school_id")
  before         Json?    @db.JsonB
  after          Json?    @db.JsonB
  ip             String?  @db.VarChar(45)
  userAgent      String?  @db.VarChar(500)
  requestId      String?  @db.VarChar(64)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  platformUser PlatformUser? @relation(fields: [platformUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([schoolId, createdAt])
  @@index([action, createdAt])
  @@map("platform_audit_logs")
}

model Announcement {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String   @db.VarChar(160)
  body        String   @db.Text
  audience    String   @default("ALL") @db.VarChar(20)
  schoolIds   String[] @db.Uuid
  severity    String   @default("INFO") @db.VarChar(20)
  publishAt   DateTime @default(now()) @db.Timestamptz(6)
  expiresAt   DateTime? @db.Timestamptz(6)
  createdBy   String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([publishAt])
  @@map("announcements")
}

model ImpersonationSession {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platformUserId String   @db.Uuid
  schoolId       String   @db.Uuid @map("school_id")
  targetUserId   String   @db.Uuid
  reason         String   @db.VarChar(500)
  consentRef     String   @db.VarChar(120)
  tokenJti       String   @unique @db.VarChar(64)
  startedAt      DateTime @default(now()) @db.Timestamptz(6)
  expiresAt      DateTime @db.Timestamptz(6)
  endedAt        DateTime? @db.Timestamptz(6)
  ip             String?  @db.VarChar(45)

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Restrict)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  targetUser   User         @relation(fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([schoolId, startedAt])
  @@map("impersonation_sessions")
}

// ───────────────────────── Tenant: settings & auth ─────────────────────────

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
  LOCKED
}

model SchoolSetting {
  schoolId             String         @id @db.Uuid
  legalName            String?        @db.VarChar(200)
  address              String?        @db.VarChar(500)
  phone                String?        @db.VarChar(24)
  email                String?        @db.VarChar(254)
  website              String?        @db.VarChar(200)
  locale               String         @default("en-NP") @db.VarChar(16)
  currency             String         @default("NPR") @db.Char(3)
  timezone             String         @default("Asia/Kathmandu") @db.VarChar(64)
  calendarSystem       CalendarSystem @default(AD)
  academicYearStartMonth Int          @default(4)
  academicYearStartDay Int            @default(1)
  workingDays          Int[]          @default([1, 2, 3, 4, 5, 6])
  periodsPerDay        Int            @default(8)
  periodMinutes        Int            @default(45)
  branding             Json           @default("{}") @db.JsonB
  attendance           Json           @default("{}") @db.JsonB
  fees                 Json           @default("{}") @db.JsonB
  enableParentPortal   Boolean        @default(true)
  enableStudentPortal  Boolean        @default(true)
  updatedAt            DateTime       @updatedAt @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("school_settings")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String   @db.Uuid @map("school_id")
  code        String   @db.VarChar(40)
  name        String   @db.VarChar(80)
  permissions String[]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  users  User[]

  @@unique([schoolId, code])
  @@map("roles")
}

model User {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId          String     @db.Uuid @map("school_id")
  roleId            String     @db.Uuid
  email             String     @db.VarChar(254)
  passwordHash      String     @db.VarChar(255)
  fullName          String     @db.VarChar(120)
  phone             String?    @db.VarChar(24)
  avatarKey         String?    @db.VarChar(500)
  status            UserStatus @default(ACTIVE)
  totpSecret        String?    @db.VarChar(64)
  totpEnabled       Boolean    @default(false)
  totpLastStep      Int?
  mustChangePassword Boolean   @default(false)
  failedAttempts    Int        @default(0)
  lockedUntil       DateTime?  @db.Timestamptz(6)
  lastLoginAt       DateTime?  @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(6)
  deletedAt         DateTime?  @db.Timestamptz(6)

  school        School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  role          Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  loginHistory  LoginHistory[]
  devices       Device[]
  impersonationSessions ImpersonationSession[]
  staff         Staff?
  student       Student?
  guardians     Guardian[]
  notices       Notice[]
  notifications Notification[]
  savedViews    SavedView[]
  storageObjects StorageObject[]
  importJobs    ImportJob[]
  attendanceSessions AttendanceSession[]
  invoices      Invoice[]
  payments      Payment[]
  refunds       Refund[]
  expenses      Expense[]
  staffLeaves   StaffLeave[]
  outboxConflicts OutboxConflict[]

  @@unique([schoolId, email])
  @@index([schoolId, status])
  @@index([schoolId, roleId])
  @@map("users")
}

model RefreshToken {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId          String    @db.Uuid @map("school_id")
  userId            String    @db.Uuid
  familyId          String    @db.Uuid
  tokenHash         String    @unique @db.VarChar(64)
  expiresAt         DateTime  @db.Timestamptz(6)
  revokedAt         DateTime? @db.Timestamptz(6)
  replacedByTokenId String?   @db.Uuid
  userAgent         String?   @db.VarChar(500)
  ip                String?   @db.VarChar(45)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String    @db.Uuid @map("school_id")
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model LoginHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String   @db.Uuid @map("school_id")
  userId    String?  @db.Uuid
  email     String   @db.VarChar(254)
  success   Boolean
  reason    String?  @db.VarChar(80)
  ip        String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId, userId, createdAt])
  @@index([schoolId, createdAt])
  @@map("login_history")
}

model Device {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String    @db.Uuid @map("school_id")
  userId         String    @db.Uuid
  deviceId       String    @db.Uuid
  name           String    @db.VarChar(120)
  platform       String    @db.VarChar(20)
  appVersion     String?   @db.VarChar(32)
  lastSeenAt     DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt      DateTime? @db.Timestamptz(6)
  wipeRequestedAt DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, deviceId])
  @@index([schoolId, userId])
  @@map("devices")
}

model NumberSequence {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String   @db.Uuid @map("school_id")
  kind      String   @db.VarChar(20)
  period    String   @db.VarChar(20)
  prefix    String   @db.VarChar(12)
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  receiptBlocks ReceiptBlock[]

  @@unique([schoolId, kind, period])
  @@map("number_sequences")
}

model ReceiptBlock {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String   @db.Uuid @map("school_id")
  sequenceId  String   @db.Uuid
  deviceId    String   @db.Uuid
  fiscalYear  String   @db.VarChar(20)
  prefix      String   @db.VarChar(12)
  startNumber Int
  endNumber   Int
  nextNumber  Int
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  school   School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sequence NumberSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([schoolId, deviceId, fiscalYear])
  @@map("receipt_blocks")
}

model IdempotencyRecord {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String   @db.Uuid @map("school_id")
  key         String   @db.VarChar(128)
  endpoint    String   @db.VarChar(160)
  requestHash String   @db.VarChar(64)
  statusCode  Int
  response    Json?    @db.JsonB
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  expiresAt   DateTime @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, key])
  @@index([schoolId, expiresAt])
  @@map("idempotency_records")
}

enum AuditActorType {
  USER
  PLATFORM_USER
  SYSTEM
  DEVICE
}

model AuditLog {
  id             String         @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String         @db.Uuid @map("school_id")
  actorUserId    String?        @db.Uuid
  actorType      AuditActorType @default(USER)
  action         String         @db.VarChar(80)
  entity         String         @db.VarChar(80)
  entityId       String?        @db.VarChar(80)
  before         Json?          @db.JsonB
  after          Json?          @db.JsonB
  ip             String?        @db.VarChar(45)
  userAgent      String?        @db.VarChar(500)
  requestId      String?        @db.VarChar(64)
  impersonationId String?       @db.Uuid
  prevHash       String         @db.VarChar(64)
  hash           String         @db.VarChar(64)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([id, createdAt])
  @@index([schoolId, createdAt])
  @@index([schoolId, entity, entityId, createdAt])
  @@index([schoolId, actorUserId, createdAt])
  @@map("audit_logs")
}

model UsageCounter {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String   @db.Uuid @map("school_id")
  metric      String   @db.VarChar(40)
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  value       Int      @default(0)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, metric, periodStart])
  @@index([schoolId, metric, periodStart])
  @@map("usage_counters")
}

// ───────────────────────── Academic setup ─────────────────────────

model AcademicYear {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String         @db.Uuid @map("school_id")
  name           String         @db.VarChar(20)
  startDate      DateTime       @db.Date
  endDate        DateTime       @db.Date
  calendarSystem CalendarSystem @default(AD)
  isCurrent      Boolean        @default(false)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)

  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms             Term[]
  holidays          Holiday[]
  teachingAssignments TeachingAssignment[]
  timetableSlots    TimetableSlot[]
  exams             Exam[]
  feeStructures     FeeStructure[]
  invoices          Invoice[]
  admissionApplications AdmissionApplication[]

  @@unique([schoolId, name])
  @@index([schoolId, isCurrent])
  @@map("academic_years")
}

model Term {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String   @db.Uuid @map("school_id")
  academicYearId String   @db.Uuid
  name           String   @db.VarChar(60)
  sequence       Int
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  exams        Exam[]

  @@unique([academicYearId, sequence])
  @@map("terms")
}

model Holiday {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String   @db.Uuid @map("school_id")
  academicYearId String?  @db.Uuid
  name           String   @db.VarChar(120)
  date           DateTime @db.Date
  endDate        DateTime? @db.Date
  type           String   @default("PUBLIC") @db.VarChar(20)
  description    String?  @db.VarChar(500)

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  @@index([schoolId, date])
  @@map("holidays")
}

model Class {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String   @db.Uuid @map("school_id")
  name      String   @db.VarChar(60)
  sequence  Int
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections          Section[]
  students          Student[]
  classSubjects     ClassSubject[]
  attendanceSessions AttendanceSession[]
  timetableSlots    TimetableSlot[]
  examSubjects      ExamSubject[]
  feeStructures     FeeStructure[]
  admissionApplications AdmissionApplication[]
  homework          Homework[]

  @@unique([schoolId, name])
  @@index([schoolId, sequence])
  @@map("classes")
}

model Section {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String   @db.Uuid @map("school_id")
  classId   String   @db.Uuid
  name      String   @db.VarChar(4)
  capacity  Int      @default(60)
  room      String?  @db.VarChar(40)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
